# Polymarket Trading Bot Configuration
# Copy this to .env and fill in your values

# Your wallet private key (KEEP SECRET - never commit .env)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Chain ID (137 = Polygon mainnet)
CHAIN_ID=137

# CLOB API endpoint
CLOB_URL=https://clob.polymarket.com

# Gamma API endpoint (market discovery)
GAMMA_URL=https://gamma-api.polymarket.com

# Starting bankroll in USDC
BANKROLL=10.0

# Max percentage of bankroll per single trade (e.g. 0.05 = 5%)
MAX_BET_FRACTION=0.05

# Minimum edge required to place a bet (e.g. 0.03 = 3%)
MIN_EDGE=0.03

# Risk management
DAILY_LOSS_CAP_PCT=0.20       # Stop trading after 20% daily loss
CASH_RESERVE_PCT=0.30         # Always keep 30% bankroll in cash
MAX_MARKET_EXPOSURE_PCT=0.20  # Max 20% bankroll in any single market

# Strategy toggles (1=enabled, 0=disabled)
STRATEGY_NO_BETS=1
STRATEGY_ARBITRAGE=1
STRATEGY_SPREAD=1

# Polling interval in seconds
POLL_INTERVAL=30

# Dry run mode (1=simulate only, 0=live trading)
DRY_RUN=1
