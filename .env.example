# Kalshi Trading Bot Configuration — AGGRESSIVE MODE
# Copy this to .env and fill in your values

# Kalshi API credentials
# Generate at: https://kalshi.com/account/profile → Create New API Key
KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./private_key.pem

# Environment: "production" or "demo"
# ALWAYS start with demo to test without real money
KALSHI_ENV=demo

# Starting bankroll in dollars (the bot reads your actual balance from Kalshi)
BANKROLL=10.0

# ── AGGRESSIVE risk management ──
MAX_BET_FRACTION=0.15            # Max 15% of bankroll per trade (was 5%)
MIN_EDGE=0.01                    # Min 1% edge after fees (was 3%)
DAILY_LOSS_CAP_PCT=0.25          # Stop trading after 25% daily loss (was 15%)
CASH_RESERVE_PCT=0.15            # Keep only 15% in cash (was 40%)
MAX_MARKET_EXPOSURE_PCT=0.30     # Max 30% in any single market (was 15%)
SURVIVAL_FLOOR=1.00              # If balance drops below $1, halt everything

# ── FAST resolution ──
MAX_DAYS_TO_RESOLVE=3            # Only markets resolving within 3 DAYS (was 30)
MIN_VOLUME_24H=25                # Min 25 contracts 24h volume (was 50)

# Strategy toggles (1=enabled, 0=disabled)
STRATEGY_DUTCH_BOOK=1
STRATEGY_TAIL_BETS=1
STRATEGY_SPREAD=1
STRATEGY_MOMENTUM=1

# Polling interval in seconds — fast for intraday trading
POLL_INTERVAL=10                 # Check every 10 seconds (was 30)

# Dry run mode (1=simulate only, 0=live trading)
DRY_RUN=1
