# Kalshi Trading Bot Configuration
# Copy this to .env and fill in your values

# Kalshi API credentials
# Generate at: https://kalshi.com/account/profile → Create New API Key
KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./private_key.pem

# Environment: "production" or "demo"
# ALWAYS start with demo to test without real money
KALSHI_ENV=demo

# Starting bankroll in dollars (the bot reads your actual balance from Kalshi)
BANKROLL=10.0

# Risk management
MAX_BET_FRACTION=0.05            # Max 5% of bankroll per trade
MIN_EDGE=0.03                    # Min 3% edge after fees to trade
DAILY_LOSS_CAP_PCT=0.15          # Stop trading after 15% daily loss
CASH_RESERVE_PCT=0.40            # Always keep 40% bankroll in cash
MAX_MARKET_EXPOSURE_PCT=0.15     # Max 15% bankroll in any single market
SURVIVAL_FLOOR=1.00              # If balance drops below $1, halt everything

# Strategy toggles (1=enabled, 0=disabled)
STRATEGY_DUTCH_BOOK=1
STRATEGY_TAIL_BETS=1
STRATEGY_SPREAD=1

# Polling interval in seconds
POLL_INTERVAL=30

# Dry run mode (1=simulate only, 0=live trading)
DRY_RUN=1
